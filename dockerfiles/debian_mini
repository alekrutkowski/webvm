FROM debian:trixie

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
    apt-utils \
    gcc \
    python3 \
    unzip \
    fakeroot \
    dbus \
    whiptail \
    hexedit \
    patch \
    wamerican \
    ucf \
    manpages \
    file \
    luajit \
    make \
    lua5.1 \
    dialog \
    curl \
    less \
    netcat-openbsd \
    r-base \
 && Rscript -e 'stopifnot(getRversion() >= "4.5.0"); cat(R.version.string, "\n")' \
 && rm -rf /var/lib/apt/lists/*

# WebVM starts the guest process with UID/GID 1000 (see config_github_terminal.js),
# so make that identity deterministic rather than relying on useradd defaults.
RUN groupadd --gid 1000 user \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash user \
 && echo "user:password" | chpasswd

COPY --chown=1000:1000 ./examples /home/user/examples

RUN chmod -R +x /home/user/examples/lua \
 && chown -R 1000:1000 /home/user \
 && chmod 0755 /home/user

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="en_US.UTF-8" \
    LC_ALL="C"

RUN echo 'root:password' | chpasswd

CMD ["/bin/bash"]
