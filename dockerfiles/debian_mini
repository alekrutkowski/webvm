FROM debian:trixie

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
    apt-utils \
    gcc \
    python3 \
    unzip \
    fakeroot \
    dbus \
    whiptail \
    hexedit \
    patch \
    wamerican \
    ucf \
    manpages \
    file \
    luajit \
    make \
    lua5.1 \
    dialog \
    curl \
    less \
    netcat-openbsd \
    r-base \
 && Rscript -e 'stopifnot(getRversion() >= "4.5.0"); cat(R.version.string, "\n")' \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m user \
 && echo "user:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples

RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="en_US.UTF-8" \
    LC_ALL="C"

RUN echo 'root:password' | chpasswd

CMD ["/bin/bash"]
